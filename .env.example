# ===== App =====
APP_NAME=JadeAI

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
# sqlite (default, zero-config) or postgresql
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/jadeai

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/jade.db

# ===== Runtime =====
# Set to `desktop` to run as a single local-user desktop client: skips
# fingerprint and NextAuth, and the database only ever has one user (id `local`).
JADE_RUNTIME=

# ===== i18n =====
DEFAULT_LOCALE=zh

# ===== Email (验证码邮件，QQ 邮箱 SMTP) =====
# QQ 邮箱 SMTP 服务器与端口（SSL）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 发件 QQ 邮箱账号
SMTP_USER=your-qq-email@qq.com
# QQ 邮箱 SMTP 授权码（在 QQ 邮箱设置-账户-开启 SMTP 后获取，非登录密码）
SMTP_PASS=your-smtp-authorization-code
# 发件人显示（可选，默认同 SMTP_USER）
SMTP_FROM=职爪 <your-qq-email@qq.com>
